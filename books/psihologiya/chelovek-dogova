<!-- ===== JS METAIMPERIYA ===== -->
<script src="../../../js/core/firebase.js?v=3.0"></script>
<script src="../../../js/core/auth.js?v=3.1"></script>
<script src="../../../js/core/app.js?v=3.3"></script>
<script src="../../../js/core/lang.js?v=3.0"></script>

<script>
function goHome() { window.location.href = 'https://metaimperiya.com/'; }

// ===== ПРОГРЕСС КНИГИ =====
window.addEventListener('load', function() {
    const target = 65;
    const fill = document.getElementById('progressFill');
    const value = document.getElementById('progressValue');
    setTimeout(() => {
        fill.style.width = target + '%';
        let cur = 0;
        const t = setInterval(() => {
            cur++;
            value.textContent = cur + '%';
            if (cur >= target) clearInterval(t);
        }, 20);
    }, 300);
});

// ===== ПОДПИСКА НА КНИГУ =====
document.getElementById('subscribeForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const email = document.getElementById('subscribeEmail').value.trim();
    const msg = document.getElementById('subscribeMsg');
    const btn = document.getElementById('subscribeBtn');

    if (!email || !email.includes('@')) {
        msg.style.color = '#ff4444';
        msg.textContent = 'Введите корректный email.';
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Отправка...';

    try {
        const db = firebase.database();
        db.ref('book_subscribers/chelovek-dogova').push({
            email: email,
            date: new Date().toISOString(),
            source: 'book-page'
        }).then(() => {
            msg.style.color = '#00f0ff';
            msg.textContent = '✅ Спасибо! Сообщим о выходе.';
            document.getElementById('subscribeForm').reset();
            btn.disabled = false;
            btn.textContent = 'Подписаться';
        }).catch(err => {
            msg.style.color = '#ff4444';
            msg.textContent = 'Ошибка отправки. Попробуйте позже.';
            btn.disabled = false;
            btn.textContent = 'Подписаться';
            console.error(err);
        });
    } catch (err) {
        msg.style.color = '#ff4444';
        msg.textContent = 'Ошибка. Попробуйте позже.';
        btn.disabled = false;
        btn.textContent = 'Подписаться';
        console.error(err);
    }
});

console.log('✅ Book page loaded: Человек договора');
</script>

</body>
