    <style>
        /* Локальные стили страницы книги — в цветах METAIMPERIYA */
        .book-wrap { max-width: 900px; margin: 0 auto; padding: 24px 16px 80px; }

        .book-hero {
            text-align: center;
            padding: 48px 24px;
            background: var(--card-bg, #111);
            border: 1px solid var(--border-color, #222);
            border-radius: 16px;
            margin-bottom: 24px;
        }
        .book-cover {
            width: 180px; height: 260px; margin: 0 auto 28px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1a0a2e, #0a0a12);
            border: 1px solid rgba(0,240,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 72px;
            box-shadow: 0 20px 60px rgba(168,85,247,0.25);
            position: relative; overflow: hidden;
        }
        .book-cover::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, transparent, rgba(0,240,255,0.1), transparent);
            animation: shine 4s infinite;
        }
        @keyframes shine {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
        .book-badge {
            display: inline-block;
            background: rgba(255,68,68,0.1);
            border: 1px solid rgba(255,68,68,0.3);
            color: var(--accent, #ff4444);
            padding: 6px 16px; border-radius: 20px;
            font-size: 12px; font-weight: 700; letter-spacing: 2px;
            text-transform: uppercase; margin-bottom: 20px;
        }
        .book-hero h1 { font-size: clamp(30px, 5vw, 52px); font-weight: 900; margin-bottom: 12px; line-height: 1.1; }
        .book-hero h1 .accent { color: var(--accent, #ff4444); }
        .book-hero .subtitle { font-size: 14px; color: var(--accent, #ff4444); letter-spacing: 2px; font-weight: 600; margin-bottom: 20px; }
        .book-hero p { color: var(--muted-text, #888); max-width: 620px; margin: 0 auto 16px; }

        /* Прогресс */
        .progress-block {
            max-width: 420px; margin: 28px auto 0;
            padding: 22px; background: rgba(0,0,0,0.2);
            border: 1px solid var(--border-color, #222); border-radius: 14px;
            text-align: left;
        }
        .progress-header { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 13px; }
        .progress-header .label { color: var(--muted-text, #888); }
        .progress-header .value { color: var(--accent, #ff4444); font-weight: 700; }
        .progress-bar { height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #00f0ff, #a855f7, #ff2d95); border-radius: 4px; transition: width 1.5s ease-out; }

        .book-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
        .book-btn {
            display: inline-block; padding: 14px 32px; border-radius: 10px;
            font-weight: 700; font-size: 15px; text-decoration: none; transition: 0.2s;
            border: none; cursor: pointer;
        }
        .book-btn-primary { background: var(--accent, #ff4444); color: #fff; }
        .book-btn-primary:hover { opacity: 0.85; transform: translateY(-2px); }
        .book-btn-outline { background: transparent; color: inherit; border: 2px solid var(--border-color, #222); }
        .book-btn-outline:hover { border-color: var(--accent, #ff4444); color: var(--accent, #ff4444); }

        .book-section { margin-bottom: 40px; }
        .book-section h2 { font-size: clamp(22px, 3vw, 32px); font-weight: 800; margin-bottom: 16px; }
        .book-section h2 .accent { color: var(--accent, #ff4444); }
        .book-section > p { color: var(--muted-text, #888); margin-bottom: 14px; }

        .topics { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 24px; }
        .topic {
            background: var(--card-bg, #111); border: 1px solid var(--border-color, #222);
            border-radius: 14px; padding: 24px; transition: 0.25s;
        }
        .topic:hover { border-color: var(--accent, #ff4444); transform: translateY(-4px); }
        .topic .icon { font-size: 28px; margin-bottom: 12px; display: inline-block; transition: 0.3s; }
        .topic:hover .icon { transform: scale(1.2) rotate(-5deg); }
        .topic h3 { font-size: 17px; margin-bottom: 8px; }
        .topic p { font-size: 14px; color: var(--muted-text, #888); }

        .quotes { display: grid; gap: 16px; margin-top: 24px; }
        .quote {
            background: var(--card-bg, #111); border-left: 3px solid var(--accent, #ff4444);
            border-radius: 0 14px 14px 0; padding: 20px 24px;
        }
        .quote p { font-size: 15px; font-style: italic; color: #ddd; margin-bottom: 8px; }
        .quote .author { font-size: 13px; color: var(--muted-text, #888); font-style: normal; }

        .subscribe-box {
            text-align: center; padding: 44px 28px; border-radius: 20px;
            background: var(--card-bg, #111); border: 1px solid var(--border-color, #222);
        }
        .subscribe-box h3 { font-size: 24px; margin-bottom: 10px; }
        .subscribe-box p { color: var(--muted-text, #888); margin-bottom: 24px; }
        .subscribe-form { max-width: 460px; margin: 0 auto 16px; display: flex; gap: 10px; flex-wrap: wrap; }
        .subscribe-form input {
            flex: 1; min-width: 180px; padding: 14px 18px;
            background: rgba(0,0,0,0.3); border: 1px solid var(--border-color, #222);
            border-radius: 10px; color: inherit; font-size: 15px; outline: none;
        }
        .subscribe-form input:focus { border-color: var(--accent, #ff4444); }
        .subscribe-form button {
            padding: 14px 28px; background: var(--accent, #ff4444); color: #fff;
            border: none; border-radius: 10px; font-weight: 700; cursor: pointer;
        }
        .subscribe-form button:hover { opacity: 0.85; }
        .subscribe-form button:disabled { opacity: 0.6; cursor: wait; }
        .subscribe-msg { font-size: 14px; min-height: 20px; }
    </style>
